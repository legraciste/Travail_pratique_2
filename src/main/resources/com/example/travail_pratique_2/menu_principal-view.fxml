<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="sectionsApplication" maxHeight="700.0" maxWidth="1200.0" minHeight="600.0" minWidth="800.0" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: linear-gradient(to right, white, #2ecc71);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.travail_pratique_2.JeuSerpentEtEchelleController">
   <left>
      <VBox prefHeight="600.0" prefWidth="175.0" spacing="50.0" style="-fx-background-color: linear-gradient(to bottom right, #2ecc71, #f1c40f); -fx-background-radius: 0 20 20 0; -fx-background-insets: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0.2, 3, 0);" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="idAccueil" minWidth="130.4" mnemonicParsing="false" onAction="#onBtnAccueilAction" style="-fx-background-color: linear-gradient(to bottom, #4CAF50, #45A049); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #2E7D32; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0.2, 0, 0);" text="Accueil" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
            <Button fx:id="idRegles" minWidth="130.4" mnemonicParsing="false" onAction="#onBtnReglesAction" style="-fx-background-color: linear-gradient(to bottom, #FF9800, #F57C00); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #E65100; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0.2, 0, 0);" text="Règles" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
            <Button fx:id="idJouerUnePartie" mnemonicParsing="false" onAction="#onBtnJouerUnePartieAction" style="-fx-background-color: linear-gradient(to bottom, #2196F3, #1976D2); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #0D47A1; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0.2, 0, 0);" text="Jouer une partie" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
            <Button fx:id="idQuitterLejeu" minWidth="130.4" mnemonicParsing="false" onAction="#onBtnQuitterLeJeuAction" style="-fx-background-color: linear-gradient(to bottom, #F44336, #D32F2F); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #B71C1C; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0.2, 0, 0);" text="Quitter le jeu" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
         </children>
         <padding>
            <Insets left="25.0" top="150.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <Pane prefHeight="600.0" prefWidth="547.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
